{
    "extensions.ignoreRecommendations": true,
    "C_Cpp.default.configurationProvider": "particle.particle-vscode-core",
    "files.associations": {
        "*.ino": "cpp"
    },
    "particle.targetPlatform": "msom",
    "particle.firmwareVersion": "6.4.1",
    "clangd.arguments": [
        "--query-driver=/home/user/.particle/toolchains/gcc-arm/**/bin/*"
    ]
}