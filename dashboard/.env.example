# copy to .env and edit
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=admin-change-me
GRAFANA_PORT=3000

# server deployment with the https profile: bind Grafana to loopback and
# let Caddy front it on the domain
#GRAFANA_BIND=127.0.0.1
#DOMAIN=fleet.example.com
#GRAFANA_ROOT_URL=https://fleet.example.com

# Particle access token for the live event stream (particle token create)
PARTICLE_TOKEN=
PARTICLE_PRODUCT_ID=44896

# directory with old SSE logs, mounted at /data for the one-off backfill
EVENT_LOG_DIR=..
